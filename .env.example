# ---------------------------------------------------------------------------
# MediSync - environment variables (Phase 8: email reminders)
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values for local testing:
#   cp .env.example .env
# NEVER commit a real .env file - it may contain credentials. This example
# only contains placeholders.

# --- Email reminders (Phase 8) ---------------------------------------------
# When EMAIL_HOST is empty, no real email is sent: the reminder is printed
# to the server console as SIMULATED so the feature can be verified locally.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=you@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=MediSync <reminders@yourdomain.com>

# --- Optional tuning ---------------------------------------------------------
# How often the due-dose check runs, in milliseconds (default 60000).
# REMINDER_CHECK_INTERVAL_MS=60000
